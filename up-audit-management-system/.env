# ============================================================
# UP Audit Management System - Demo configuration
# All runtime configuration is handled through this .env file.
# NOTE: values are read when the dev server / build starts,
# so restart "npm run dev" after changing anything here.
# ============================================================

# ---- App identity -----------------------------------------
VITE_APP_NAME="UP Audit Management System"
VITE_APP_SHORT_NAME="UP-AMS"
VITE_ORG_NAME="Government of Uttar Pradesh"
VITE_ORG_UNIT="State Audit Department"

# ---- Demo behaviour ---------------------------------------
# Demo mode shows demo banners, demo accounts on the login page, etc.
VITE_DEMO_MODE=true
# Seed realistic demo data into browser storage on first run
VITE_SEED_DEMO_DATA=true
# Wipe and re-seed browser storage when the seed version changes
VITE_RESET_DATA_ON_VERSION_CHANGE=true
# Password used by all seeded demo accounts
VITE_DEMO_PASSWORD="demo123"
# Enable AI-assisted features (risk scoring, anomaly detection,
# predictive compliance). The "AI" is a transparent rule-based model.
VITE_ENABLE_AI_FEATURES=true
VITE_AI_MODEL_LABEL="Rule-based demo model v1"

# ---- Single sign-on (simulated for the demo) ---------------
VITE_SSO_ENABLED=true
VITE_SSO_PROVIDER_NAME="UP Parichay SSO"

# ---- Integration endpoints (mock endpoints, demo only) -----
VITE_PFMS_ENDPOINT="https://pfms-demo.example.gov.in/api/v2"
VITE_EOFFICE_ENDPOINT="https://eoffice-demo.example.gov.in/api"
VITE_KOSH_ENDPOINT="https://kosh-demo.example.gov.in/api"
VITE_DDO_ENDPOINT="https://ddo-demo.example.gov.in/api"

# ---- Browser storage keys ----------------------------------
VITE_DB_NAME="up_ams_db"
VITE_DB_VERSION="1"
VITE_STORAGE_PREFIX="upams"
VITE_SYNC_CHANNEL="up-ams-sync"

# ---- UI defaults -------------------------------------------
VITE_DEFAULT_PAGE_SIZE="10"
VITE_MAX_UPLOAD_MB="10"
VITE_CURRENCY="INR"
# "auto" derives the Indian financial year (Apr-Mar) from the
# current date, or set a fixed value like "2025-26"
VITE_FISCAL_YEAR="auto"
# Session timeout in minutes (0 = never expire - demo friendly)
VITE_SESSION_TIMEOUT_MINUTES="0"

# ---- Email simulation --------------------------------------
# Outbound email is simulated and only written to an outbox log
VITE_EMAIL_SIMULATION=true
VITE_EMAIL_DOMAIN="up.gov.in"
