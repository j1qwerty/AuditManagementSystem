# ------------------------------------------------------------------
# Audit Management System - runtime configuration
# Every value below is read by the app at startup (VITE_* variables).
# ---------------------------------------------------------------

# --- Branding -----------------------------------------------------
VITE_APP_NAME=Audit Management System
VITE_APP_SHORT_NAME=AMS
VITE_ORG_NAME=Head Office
VITE_ORG_UNIT=Audit & Compliance Wing

# --- Data ---------------------------------------------------------
# Seed sample workspace data on first launch (true/false)
VITE_SEED_DEMO_DATA=true
# Force a fresh seed when the data layout changes
VITE_RESET_DATA_ON_VERSION_CHANGE=true
VITE_DEMO_PASSWORD=demo123  # password used by seeded accounts

# --- Modules & features --------------------------------------------
VITE_ENABLE_AI_FEATURES=true
VITE_AI_MODEL_LABEL=Rule-based model v1

# --- Single sign-on ------------------------------------------------
VITE_SSO_ENABLED=true
VITE_SSO_PROVIDER_NAME=Office SSO

# --- Developer / integration endpoints ------------------------------
VITE_PFMS_ENDPOINT=https://pfms.internal.example/api/v2
VITE_EOFFICE_ENDPOINT=https://eoffice.internal.example/api
VITE_KOSH_ENDPOINT=https://kosh.internal.example/api
VITE_DDO_ENDPOINT=https://ddo.internal.example/api

# --- Local storage ---------------------------------------------------
VITE_DB_NAME=ams_db
VITE_DB_VERSION=2
VITE_STORAGE_PREFIX=ams
VITE_SYNC_CHANNEL=ams-sync

# --- Workspace defaults ----------------------------------------------
VITE_DEFAULT_PAGE_SIZE=10
VITE_MAX_UPLOAD_MB=10
VITE_CURRENCY=INR
# Indian financial year (Apr-Mar). "auto" derives it from the current date.
VITE_FISCAL_YEAR=auto
# Auto sign-out after N minutes of inactivity (0 = disabled)
VITE_SESSION_TIMEOUT_MINUTES=0

# --- Email gateway -----------------------------------------------------
VITE_EMAIL_SIMULATION=true
VITE_EMAIL_DOMAIN=auditms.in
